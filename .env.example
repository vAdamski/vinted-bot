# --- Bot Discord (wymagany) ---
# Developer Portal → Twoja aplikacja → Bot → Reset Token
DISCORD_BOT_TOKEN=
# ID serwera (prawy klik na nazwę serwera → Kopiuj ID serwera; wymaga Trybu dewelopera)
DISCORD_GUILD_ID=
# ID kanału domyślnego na powiadomienia (prawy klik na kanał → Kopiuj ID kanału)
DISCORD_CHANNEL_ID=

# Opcjonalnie: proxy HTTP/SOCKS dla zapytań do Vinted, np. http://user:pass@host:port
# VINTED_PROXY=

# Opcjonalnie: nadpisuje logging.level z config.yaml (DEBUG/INFO/WARNING)
# LOG_LEVEL=INFO
